// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    String   @unique @map("user_id") // Stack Auth user ID
  role      String   @default("user") // "admin", "user", etc.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_roles")
}

model UserProfile {
  id        Int      @id @default(autoincrement())
  userId    String   @unique @map("user_id") // Stack Auth user ID
  cpf       String   @unique // CPF do usuário
  phone     String   @map("phone") // Telefone do usuário
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_profiles")
}

model Template {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  content     String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("templates")
}

model Customer {
  id              Int       @id @default(autoincrement())
  abacatePayId    String?   @unique @map("abacatepay_id") // ID do cliente no AbacatePay
  userId          String?   @map("user_id") // Stack Auth user ID (opcional)
  name            String
  email           String
  cellphone       String
  taxId           String    @map("tax_id") // CPF ou CNPJ
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  payments        Payment[]

  @@map("customers")
}

model Payment {
  id              Int       @id @default(autoincrement())
  abacatePayId    String    @unique @map("abacatepay_id") // ID da cobrança no AbacatePay
  customerId      Int       @map("customer_id")
  amount          Int       // Valor em centavos
  status          String    @default("PENDING") // PENDING, PAID, EXPIRED, CANCELLED
  description     String?
  brCode          String?   @map("br_code") @db.Text // Código PIX copia-e-cola
  brCodeBase64    String?   @map("br_code_base64") @db.Text // QR Code em base64
  platformFee     Int?      @map("platform_fee") // Taxa da plataforma em centavos
  devMode         Boolean   @default(false) @map("dev_mode")
  externalId      String?   @map("external_id") // ID externo (ex: ID da proposta)
  expiresAt       DateTime? @map("expires_at")
  paidAt          DateTime? @map("paid_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions    Transaction[]

  @@index([customerId])
  @@index([status])
  @@index([externalId])
  @@map("payments")
}

model Transaction {
  id              Int       @id @default(autoincrement())
  paymentId       Int       @map("payment_id")
  type            String    // WEBHOOK, STATUS_CHECK, REFUND, etc
  status          String    // Status no momento da transação
  metadata        String?   @db.Text // JSON com dados adicionais
  createdAt       DateTime  @default(now()) @map("created_at")
  
  payment         Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("transactions")
}
